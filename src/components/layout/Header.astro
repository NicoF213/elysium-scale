---
import Navigation from './Navigation.astro';
import { siteConfig } from '../../config/site';
import { getLangFromUrl, getAlternateUrl, useTranslations } from '../../utils/i18n';

const currentPath = Astro.url.pathname;
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// Language switcher target
const alternateUrl = getAlternateUrl(currentPath, currentLang);
const alternateLangLabel = t('lang.switch_label');
const alternateLangAria = t('lang.switch_aria');

// Nav paths depend on current language
const isEnglish = currentLang === 'en';
const productsHref = isEnglish ? '/en/products' : '/produits';
const seeProductsLabel = t('nav.see_products');
---

<header
  class="sticky top-0 z-50 w-full border-b border-dark-border/50 bg-dark-bg/80 backdrop-blur-xl"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <a href={isEnglish ? '/en' : '/'} class="flex items-center gap-3 group" aria-label={siteConfig.name}>
        <img
          src="/logo.png"
          alt={`Logo ${siteConfig.name}`}
          width="40"
          height="40"
          class="rounded-xl transition-transform duration-300 group-hover:scale-105"
        />
        <span class="text-lg font-bold text-text-primary hidden sm:block">
          {siteConfig.name}
        </span>
      </a>

      <!-- Navigation desktop -->
      <div class="hidden md:block">
        <Navigation currentPath={currentPath} lang={currentLang} />
      </div>

      <!-- CTA + language switcher -->
      <div class="flex items-center gap-3">
        <!-- YouTube -->
        {siteConfig.social.youtube && (
          <a
            href={siteConfig.social.youtube}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Chaîne YouTube Elysium Scale"
            class="p-2 rounded-lg text-text-muted hover:text-[#FF0000] transition-colors duration-200"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        )}

        <!-- Language switcher -->
        <a
          href={alternateUrl}
          aria-label={alternateLangAria}
          class="hidden sm:inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-lg border border-dark-border text-text-muted hover:text-text-primary hover:border-dark-border/80 transition-colors duration-200"
        >
          {alternateLangLabel}
        </a>

        <a
          href={productsHref}
          class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 text-sm font-semibold rounded-xl bg-brand-gradient text-white transition-opacity duration-200 hover:opacity-90"
        >
          {seeProductsLabel}
        </a>

        <!-- Burger mobile -->
        <button
          id="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={t('nav.open_menu')}
          class="md:hidden p-2 rounded-lg text-text-secondary hover:text-text-primary hover:bg-dark-surface transition-colors"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path id="icon-open" d="M4 6h16M4 12h16M4 18h16" />
            <path id="icon-close" class="hidden" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Menu mobile -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-dark-border/50">
    <div class="mx-auto max-w-7xl px-4 py-4 flex flex-col gap-1">
      {siteConfig.navigation.map((item) => {
        // Remap href for English if needed
        const href = isEnglish
          ? item.href === '/' ? '/en'
            : item.href === '/blog' ? '/en/blog'
            : item.href === '/produits' ? '/en/products'
            : item.href === '/a-propos' ? '/en/about'
            : item.href
          : item.href;
        const isActive = currentPath === href || (href !== '/' && href !== '/en' && currentPath.startsWith(href));
        return (
          <a
            href={href}
            class:list={[
              'px-4 py-3 text-sm font-medium rounded-xl transition-colors',
              isActive
                ? 'text-text-primary bg-dark-surface-2'
                : 'text-text-secondary hover:text-text-primary hover:bg-dark-surface',
            ]}
          >
            {isEnglish
              ? item.href === '/' ? 'Home'
                : item.href === '/blog' ? 'Blog'
                : item.href === '/produits' ? 'Products'
                : item.href === '/a-propos' ? 'About'
                : item.label
              : item.label}
          </a>
        );
      })}
      <!-- Language switcher (mobile) -->
      <a
        href={alternateUrl}
        class="px-4 py-3 text-sm font-medium rounded-xl text-text-secondary hover:text-text-primary hover:bg-dark-surface transition-colors"
      >
        {alternateLangLabel} — {alternateLangAria}
      </a>
      <a
        href={productsHref}
        class="mt-2 px-4 py-3 text-sm font-semibold rounded-xl bg-brand-gradient text-white text-center"
      >
        {seeProductsLabel}
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden') === false;
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Ouvrir le menu' : 'Fermer le menu');
  });
</script>
