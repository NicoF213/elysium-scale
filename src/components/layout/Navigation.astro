---
import { siteConfig } from '../../config/site';
import type { Lang } from '../../utils/i18n';

interface Props {
  currentPath?: string;
  lang?: Lang;
}

const { currentPath = '/', lang = 'fr' } = Astro.props;
const isEnglish = lang === 'en';

// Build locale-aware nav items from siteConfig
const navItems = siteConfig.navigation.map((item) => {
  let href = item.href;
  let label = item.label;
  if (isEnglish) {
    if (item.href === '/') { href = '/en'; label = 'Home'; }
    else if (item.href === '/blog') { href = '/en/blog'; label = 'Blog'; }
    else if (item.href === '/produits') { href = '/en/products'; label = 'Products'; }
    else if (item.href === '/a-propos') { href = '/en/about'; label = 'About'; }
  }
  return { href, label };
});
---

<nav aria-label="Navigation principale">
  <ul class="flex items-center gap-1 md:gap-2">
    {navItems.map((item) => {
      const isRoot = item.href === '/' || item.href === '/en';
      const isActive = currentPath === item.href || (!isRoot && currentPath.startsWith(item.href));
      return (
        <li>
          <a
            href={item.href}
            class:list={[
              'relative px-3 py-2 text-sm font-medium rounded-lg transition-colors duration-200',
              isActive
                ? 'text-text-primary bg-dark-surface-2'
                : 'text-text-secondary hover:text-text-primary hover:bg-dark-surface',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label}
            {isActive && (
              <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-4 h-0.5 bg-brand-gradient rounded-full" />
            )}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
