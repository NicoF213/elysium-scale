---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  items: FAQItem[];
}

const { title = 'Questions fréquentes', items } = Astro.props;
---

<section class="py-16">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-text-primary">{title}</h2>
    </div>

    <dl class="space-y-3">
      {items.map((item, index) => (
        <div class="rounded-2xl border border-dark-border bg-dark-surface/50 overflow-hidden">
          <dt>
            <button
              type="button"
              class="flex w-full items-center justify-between px-6 py-5 text-left text-sm font-semibold text-text-primary hover:text-brand-purple transition-colors"
              aria-expanded="false"
              aria-controls={`faq-answer-${index}`}
              id={`faq-btn-${index}`}
            >
              <span>{item.question}</span>
              <svg
                class="w-5 h-5 shrink-0 ml-4 text-text-muted transition-transform duration-300"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </dt>
          <dd
            id={`faq-answer-${index}`}
            role="region"
            aria-labelledby={`faq-btn-${index}`}
            class="hidden px-6 pb-5 text-sm text-text-secondary leading-relaxed"
          >
            {item.answer}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[id^="faq-btn-"]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      const answer = document.getElementById(btn.getAttribute('aria-controls') ?? '');
      const icon = btn.querySelector('svg');

      btn.setAttribute('aria-expanded', String(!isExpanded));
      answer?.classList.toggle('hidden');
      icon?.style.setProperty('transform', isExpanded ? 'rotate(0deg)' : 'rotate(180deg)');
    });
  });
</script>
