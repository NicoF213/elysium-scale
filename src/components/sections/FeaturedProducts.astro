---
import { getCollection } from 'astro:content';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import StarRating from '../ui/StarRating.astro';
import AffiliateLink from '../ui/AffiliateLink.astro';
import type { Lang } from '../../utils/i18n';
import { useTranslations } from '../../utils/i18n';

interface Props {
  limit?: number;
  title?: string;
  subtitle?: string;
  lang?: Lang;
}

const { limit = 3, lang = 'fr' } = Astro.props;
const t = useTranslations(lang);

const {
  title = t('products.heading'),
  subtitle = lang === 'fr'
    ? 'Nos sélections soigneusement testées et approuvées'
    : 'Our carefully tested and approved selections',
} = Astro.props;

const productsBase = lang === 'en' ? '/en/products' : '/produits';

const allProducts = await getCollection('products', ({ data }) => data.lang === lang);
const featured = allProducts.filter((p) => p.data.featured).slice(0, limit);
const products = featured.length > 0 ? featured : allProducts.slice(0, limit);
---

{products.length > 0 && (
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-text-primary mb-3">{title}</h2>
        <p class="text-text-secondary max-w-xl mx-auto">{subtitle}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {products.map((product) => {
          const color = product.data.brandColor;
          return (
            <Card hoverable padding="none">
              <div class="p-6 flex flex-col h-full">

                <!-- Logo + badges -->
                <div class="flex items-start justify-between mb-4">
                  <div class="flex items-center gap-3">
                    {product.data.image && (
                      <div
                        class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 overflow-hidden"
                        style={color ? `background-color: ${color}10; border: 1px solid ${color}40;` : ''}
                      >
                        <img
                          src={product.data.image}
                          alt={product.data.imageAlt ?? product.data.name}
                          width="40"
                          height="40"
                          class="w-8 h-8 object-contain"
                        />
                      </div>
                    )}
                    <Badge variant="purple">{product.data.category}</Badge>
                  </div>
                  {product.data.featured && (
                    <Badge variant="pink">{t('products.top_choice')}</Badge>
                  )}
                </div>

                <!-- Nom + note -->
                <h3 class="text-lg font-bold text-text-primary mb-2">{product.data.name}</h3>
                <StarRating rating={product.data.rating} size="sm" />

                <!-- Description -->
                <p class="mt-3 text-sm text-text-secondary line-clamp-3 flex-1">
                  {product.data.description}
                </p>

                <!-- Pros -->
                <ul class="mt-4 space-y-1.5">
                  {product.data.pros.slice(0, 2).map((pro) => (
                    <li class="flex items-center gap-2 text-sm text-text-secondary">
                      <svg class="w-4 h-4 text-success shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <path d="M20 6L9 17l-5-5" />
                      </svg>
                      {pro}
                    </li>
                  ))}
                </ul>

                <!-- Footer -->
                <div class="mt-6 pt-4 border-t border-dark-border flex items-center justify-between gap-3">
                  {product.data.price && (
                    <span class="text-sm font-semibold text-text-primary">{product.data.price}</span>
                  )}
                  <div class="flex items-center gap-2 ml-auto">
                    <a
                      href={`${productsBase}/${product.slug}`}
                      class="text-sm text-text-secondary hover:text-text-primary transition-colors"
                    >
                      {t('products.see_review')}
                    </a>
                    <AffiliateLink
                      affiliateId={product.data.affiliateId}
                      size="sm"
                      customColor={color}
                    />
                  </div>
                </div>

              </div>
            </Card>
          );
        })}
      </div>

      <div class="text-center mt-10">
        <a
          href={productsBase}
          class="inline-flex items-center gap-2 text-sm font-medium text-brand-purple hover:text-brand-pink transition-colors"
        >
          {t('products.all')}
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>
)}
