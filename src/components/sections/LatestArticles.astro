---
import { getCollection } from 'astro:content';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import { formatDateShort } from '../../utils/formatPrice';
import type { Lang } from '../../utils/i18n';
import { useTranslations } from '../../utils/i18n';

interface Props {
  limit?: number;
  title?: string;
  subtitle?: string;
  excludeSlug?: string;
  lang?: Lang;
}

const { limit = 3, excludeSlug, lang = 'fr' } = Astro.props;
const t = useTranslations(lang);

const {
  title = t('blog.heading'),
  subtitle = lang === 'fr'
    ? 'Guides, comparatifs et analyses pour faire les meilleurs choix'
    : 'Guides, comparisons and analysis to help you make the best decisions',
} = Astro.props;

const blogBase = lang === 'en' ? '/en/blog' : '/blog';

const allArticles = await getCollection('articles', ({ data }) => !data.draft && data.lang === lang);
const sorted = allArticles
  .filter((a) => a.slug !== excludeSlug)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, limit);
---

{sorted.length > 0 && (
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-text-primary mb-3">{title}</h2>
        <p class="text-text-secondary max-w-xl mx-auto">{subtitle}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sorted.map((article) => (
          <Card href={`${blogBase}/${article.slug}`} hoverable padding="none">
            <article>
              {article.data.image && (
                <div class="aspect-[16/9] overflow-hidden rounded-t-2xl">
                  <img
                    src={article.data.image}
                    alt={article.data.imageAlt ?? article.data.title}
                    width="400"
                    height="225"
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
              )}
              <div class="p-6">
                <div class="flex items-center gap-3 mb-3">
                  <Badge variant="blue">{article.data.category}</Badge>
                  <time
                    datetime={article.data.publishDate.toISOString()}
                    class="text-xs text-text-muted"
                  >
                    {formatDateShort(article.data.publishDate)}
                  </time>
                </div>
                <h3 class="font-bold text-text-primary mb-2 line-clamp-2 group-hover:text-brand-purple transition-colors">
                  {article.data.title}
                </h3>
                <p class="text-sm text-text-secondary line-clamp-3">{article.data.description}</p>

                <div class="mt-4 flex flex-wrap gap-1.5">
                  {article.data.tags.slice(0, 3).map((tag) => (
                    <span class="text-xs text-text-muted bg-dark-surface px-2 py-0.5 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </article>
          </Card>
        ))}
      </div>

      <div class="text-center mt-10">
        <a
          href={blogBase}
          class="inline-flex items-center gap-2 text-sm font-medium text-brand-purple hover:text-brand-pink transition-colors"
        >
          {t('blog.all_articles')}
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>
)}
