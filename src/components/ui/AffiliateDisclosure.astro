---
import type { Lang } from '../../utils/i18n';
import { useTranslations } from '../../utils/i18n';

interface Props {
  compact?: boolean;
  lang?: Lang;
}

const { compact = false, lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
---

{compact ? (
  <p class="text-xs text-text-muted italic border-l-2 border-dark-border pl-3 py-1">
    {t('disclosure.compact')}
  </p>
) : (
  <aside
    class="flex gap-3 p-4 rounded-xl bg-brand-purple/10 border border-brand-purple/20 text-sm text-text-secondary"
    aria-label={t('disclosure.label')}
  >
    <svg class="w-5 h-5 text-brand-purple shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="10" />
      <path d="M12 16v-4M12 8h.01" />
    </svg>
    <div>
      <strong class="text-text-primary block mb-0.5">{t('disclosure.label')}</strong>
      {t('disclosure.text')}
      <a href={t('disclosure.legal_href')} class="text-brand-purple hover:text-brand-pink ml-1 underline underline-offset-2">
        {t('disclosure.link')}
      </a>
    </div>
  </aside>
)}
