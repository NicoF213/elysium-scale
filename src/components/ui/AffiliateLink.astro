---
import { buildAffiliateUrl, getAffiliateLabel } from '../../utils/buildAffiliateUrl';

interface Props {
  affiliateId: string;
  label?: string;
  variant?: 'button-primary' | 'button-outline' | 'inline';
  size?: 'sm' | 'md' | 'lg';
  customColor?: string;
  class?: string;
}

const {
  affiliateId,
  label,
  variant = 'button-primary',
  size = 'md',
  customColor,
  class: className = '',
} = Astro.props;

const href = buildAffiliateUrl(affiliateId);
const displayLabel = label ?? getAffiliateLabel(affiliateId);

const buttonBase =
  'inline-flex items-center justify-center gap-2 font-semibold rounded-xl transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-dark-bg active:scale-[0.98]';

const sizeClasses = {
  sm: 'px-3.5 py-2 text-sm',
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-3.5 text-base',
};

// Quand customColor est fourni on utilise un style inline plutôt que la classe gradient
const hasCustomColor = Boolean(customColor);

const variantClasses = {
  'button-primary': hasCustomColor
    ? `${buttonBase} text-white hover:opacity-90`
    : `${buttonBase} bg-brand-gradient text-white hover:opacity-90`,
  'button-outline': hasCustomColor
    ? `${buttonBase} border-2 bg-transparent hover:opacity-90`
    : `${buttonBase} border border-brand-purple text-brand-purple hover:bg-brand-purple/10`,
  inline: 'transition-colors font-medium underline underline-offset-2',
};

const classes =
  variant === 'inline'
    ? [variantClasses.inline, className].join(' ')
    : [variantClasses[variant], sizeClasses[size], className].join(' ');

const inlineStyle = hasCustomColor
  ? variant === 'button-primary'
    ? `background-color: ${customColor}; focus-visible-ring-color: ${customColor};`
    : variant === 'button-outline'
      ? `border-color: ${customColor}; color: ${customColor};`
      : `color: ${customColor};`
  : undefined;
---

<a
  href={href}
  rel="nofollow sponsored noopener"
  target="_blank"
  class={classes}
  style={inlineStyle}
  aria-label={`${displayLabel} (lien affilié, s'ouvre dans un nouvel onglet)`}
>
  {displayLabel}
  {variant !== 'inline' && (
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6" />
      <polyline points="15 3 21 3 21 9" />
      <line x1="10" y1="14" x2="21" y2="3" />
    </svg>
  )}
</a>
