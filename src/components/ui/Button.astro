---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  target?: string;
  rel?: string;
  disabled?: boolean;
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className = '',
  target,
  rel,
  disabled = false,
  'aria-label': ariaLabel,
} = Astro.props;

const baseClasses = 'inline-flex items-center justify-center gap-2 font-semibold rounded-xl transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple focus-visible:ring-offset-2 focus-visible:ring-offset-dark-bg disabled:opacity-50 disabled:cursor-not-allowed';

const variantClasses = {
  primary: 'bg-brand-gradient text-white hover:opacity-90 active:scale-[0.98]',
  secondary: 'bg-dark-surface-2 text-text-primary hover:bg-dark-border border border-dark-border',
  outline: 'border border-brand-purple text-brand-purple hover:bg-brand-purple/10',
  ghost: 'text-text-secondary hover:text-text-primary hover:bg-dark-surface',
};

const sizeClasses = {
  sm: 'px-3.5 py-2 text-sm',
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-3.5 text-base',
};

const classes = [baseClasses, variantClasses[variant], sizeClasses[size], className].join(' ');
---

{href ? (
  <a href={href} class={classes} target={target} rel={rel} aria-label={ariaLabel}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} disabled={disabled} aria-label={ariaLabel}>
    <slot />
  </button>
)}
