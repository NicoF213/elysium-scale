---
interface Props {
  rating: number;
  max?: number;
  showLabel?: boolean;
  size?: 'sm' | 'md' | 'lg';
}

const { rating, max = 5, showLabel = true, size = 'md' } = Astro.props;

const clampedRating = Math.min(Math.max(rating, 0), max);
const fullStars = Math.floor(clampedRating);
const hasHalf = clampedRating % 1 >= 0.5;
const emptyStars = max - fullStars - (hasHalf ? 1 : 0);

const sizeMap = {
  sm: 'w-3.5 h-3.5',
  md: 'w-4 h-4',
  lg: 'w-5 h-5',
};
const textSize = { sm: 'text-xs', md: 'text-sm', lg: 'text-base' };
const starClass = sizeMap[size];
---

<div class="flex items-center gap-1.5" aria-label={`Note : ${clampedRating} sur ${max}`}>
  <div class="flex items-center">
    {Array.from({ length: fullStars }).map(() => (
      <svg class:list={[starClass, 'text-warning fill-current']} viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
      </svg>
    ))}
    {hasHalf && (
      <svg class:list={[starClass, 'text-warning']} viewBox="0 0 24 24" aria-hidden="true">
        <defs>
          <linearGradient id="half-star">
            <stop offset="50%" stop-color="currentColor" />
            <stop offset="50%" stop-color="transparent" />
          </linearGradient>
        </defs>
        <path fill="url(#half-star)" stroke="currentColor" stroke-width="1" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
      </svg>
    )}
    {Array.from({ length: emptyStars }).map(() => (
      <svg class:list={[starClass, 'text-dark-border']} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
      </svg>
    ))}
  </div>
  {showLabel && (
    <span class:list={[textSize[size], 'text-text-secondary font-medium']}>
      {clampedRating.toFixed(1)}
    </span>
  )}
</div>
