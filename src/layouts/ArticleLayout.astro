---
import BaseLayout from './BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import AffiliateDisclosure from '../components/ui/AffiliateDisclosure.astro';
import { formatDate } from '../utils/formatPrice';
import { siteConfig } from '../config/site';
import type { Lang } from '../utils/i18n';
import { useTranslations } from '../utils/i18n';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  author?: string;
  category: string;
  tags: string[];
  image?: string;
  imageAlt?: string;
  hasAffiliateLinks?: boolean;
  lang?: Lang;
}

const {
  title,
  description,
  publishDate,
  updatedDate,
  author = siteConfig.author,
  category,
  tags,
  image,
  imageAlt,
  hasAffiliateLinks = true,
  lang = 'fr',
} = Astro.props;

const t = useTranslations(lang);
const homeHref = lang === 'en' ? '/en' : '/';
const blogHref = lang === 'en' ? '/en/blog' : '/blog';
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  type="article"
  publishDate={publishDate}
  updatedDate={updatedDate}
  author={author}
  lang={lang}
>
  <article class="py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav aria-label="Fil d'Ariane" class="mb-8">
        <ol class="flex items-center gap-2 text-sm text-text-muted">
          <li><a href={homeHref} class="hover:text-text-secondary transition-colors">{t('bc.home')}</a></li>
          <li aria-hidden="true"><span class="text-dark-border">/</span></li>
          <li><a href={blogHref} class="hover:text-text-secondary transition-colors">{t('bc.blog')}</a></li>
          <li aria-hidden="true"><span class="text-dark-border">/</span></li>
          <li class="text-text-secondary truncate max-w-[200px]" aria-current="page">{title}</li>
        </ol>
      </nav>

      <!-- Header -->
      <header class="mb-8">
        <div class="flex items-center gap-3 mb-4">
          <Badge variant="blue">{category}</Badge>
          {tags.slice(0, 2).map((tag) => (
            <span class="text-xs text-text-muted bg-dark-surface px-2.5 py-0.5 rounded-full">{tag}</span>
          ))}
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-text-primary mb-4 leading-tight">
          {title}
        </h1>

        <p class="text-lg text-text-secondary mb-6">{description}</p>

        <div class="flex items-center gap-4 text-sm text-text-muted border-t border-dark-border pt-5">
          <span>{t('blog.by')} <strong class="text-text-secondary">{author}</strong></span>
          <span class="text-dark-border">·</span>
          <time datetime={publishDate.toISOString()}>
            {t('blog.published_on')} {formatDate(publishDate)}
          </time>
          {updatedDate && (
            <>
              <span class="text-dark-border">·</span>
              <time datetime={updatedDate.toISOString()}>
                {t('blog.updated_on')} {formatDate(updatedDate)}
              </time>
            </>
          )}
        </div>
      </header>

      <!-- Hero image -->
      {image && (
        <div class="mb-8 rounded-2xl overflow-hidden">
          <img
            src={image}
            alt={imageAlt ?? title}
            width="800"
            height="450"
            class="w-full h-auto"
          />
        </div>
      )}

      <!-- Affiliate disclosure -->
      {hasAffiliateLinks && (
        <div class="mb-8">
          <AffiliateDisclosure lang={lang} />
        </div>
      )}

      <!-- Article content -->
      <div class="prose-elysium">
        <slot />
      </div>

      <!-- Tags -->
      <div class="mt-10 pt-6 border-t border-dark-border">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-sm text-text-muted">{t('blog.tags')}</span>
          {tags.map((tag) => (
            <span class="text-xs text-text-secondary bg-dark-surface border border-dark-border px-3 py-1 rounded-full">
              {tag}
            </span>
          ))}
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
